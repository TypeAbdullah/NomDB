# NomDB Server Configuration
NOMDB_HOST=0.0.0.0
NOMDB_PORT=6379
NOMDB_DATABASES=16
NOMDB_PASSWORD=
NOMDB_REQUIRE_AUTH=false

# Memory & Eviction
NOMDB_MAX_MEMORY_BYTES=0
NOMDB_MAX_MEMORY_POLICY=noeviction

# Persistence
NOMDB_AOF_ENABLED=true
NOMDB_AOF_FILENAME=appendonly.aof
NOMDB_AOF_FSYNC=everysec
NOMDB_SNAPSHOT_ENABLED=true
NOMDB_SNAPSHOT_FILENAME=dump.nomdb
NOMDB_DATA_DIR=./data

# Expiration
NOMDB_ACTIVE_EXPIRE_INTERVAL_MS=100
NOMDB_ACTIVE_EXPIRE_BATCH_SIZE=20

# Replication
NOMDB_REPLICA_OF=
NOMDB_REPLICA_PORT=
NOMDB_REPLICATION_BACKLOG_SIZE=1048576

# Cluster
NOMDB_CLUSTER_ENABLED=false
NOMDB_CLUSTER_NODE_ID=
NOMDB_CLUSTER_CONFIG_FILE=nodes.conf

# Logging & Observability
NOMDB_LOG_LEVEL=INFO
NOMDB_LOG_FORMAT=json
NOMDB_METRICS_ENABLED=true
NOMDB_METRICS_PORT=9121
